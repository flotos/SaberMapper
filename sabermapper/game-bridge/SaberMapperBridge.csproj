<Project Sdk="Microsoft.NET.Sdk">
  <!-- For a future `dotnet build`. The supported build today is `sabermapper game build-bridge`
       (Roslyn csc, see sabermapper/game/build.py); keep the reference list in sync with build.REFERENCES. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SaberMapperBridge</AssemblyName>
    <RootNamespace>SaberMapperBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <Deterministic>true</Deterministic>
    <BeatSaberDir Condition="'$(BeatSaberDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Beat Saber</BeatSaberDir>
    <Managed>$(BeatSaberDir)\Beat Saber_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="SaberMapperBridge.manifest.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(Managed)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(Managed)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(Managed)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(Managed)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(Managed)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Main"><HintPath>$(Managed)\Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DataModels"><HintPath>$(Managed)\DataModels.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatmapCore"><HintPath>$(Managed)\BeatmapCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GameplayCore"><HintPath>$(Managed)\GameplayCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BGLib.AppFlow"><HintPath>$(Managed)\BGLib.AppFlow.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BGLib.UnityExtension"><HintPath>$(Managed)\BGLib.UnityExtension.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BGLib.Polyglot"><HintPath>$(Managed)\BGLib.Polyglot.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatSaber.ViewSystem"><HintPath>$(Managed)\BeatSaber.ViewSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HMLib"><HintPath>$(Managed)\HMLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colors"><HintPath>$(Managed)\Colors.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zenject"><HintPath>$(Managed)\Zenject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zenject-usage"><HintPath>$(Managed)\Zenject-usage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(Managed)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(Managed)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IPA.Loader"><HintPath>$(Managed)\IPA.Loader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SongCore"><HintPath>$(BeatSaberDir)\Plugins\SongCore.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
